node_modules/
dist/
shots/

# runtime-only 3D model drops for ?render3d — never committed (see
# public/models/README.md); only the manifest and README belong in git
public/models/*.glb
public/models/*.gltf
public/models/*.bin
public/models/*.vrm

# dev scratch: headless model probes and the Playwright viewer driver
.probe*.mjs
.shots.mjs
.t*.js
.play.mjs
# ...and everything else in the same family. A dot-prefixed .mjs at the repo
# root is always a scratch driver; one of them got swept into a commit by a
# `git add -A` before this line existed.
.*.mjs

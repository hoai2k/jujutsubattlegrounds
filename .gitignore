node_modules/
dist/
shots/

# workbench throwaway dummies for the ?render3d pipeline — real models in
# public/models/ ARE committed (loaded at runtime, never bundled)
public/models/dummy*.glb

# dev scratch: headless model probes and the Playwright viewer driver
.probe*.mjs
.shots.mjs
.t*.js
.play.mjs
# ...and everything else in the same family. A dot-prefixed .mjs at the repo
# root is always a scratch driver; one of them got swept into a commit by a
# `git add -A` before this line existed.
.*.mjs
